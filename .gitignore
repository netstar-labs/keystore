# Test binary, built with `go test -c`
*.test

# Editor/IDE
.vscode/
.claude

# macOS
**/.DS_Store
**/~*

# transient work dirs
_bin/
_dev/
sandbox/
install/
testdata/
# except the committed format fixtures (golden vectors pin the ring format)
!/testdata/

# ring lock files (created beside a ring on every write)
*.ks.lock

# working plans stay local; the rest of docs/ is committed
docs/plan/

# binaries built at repo root
/keystore
/keystore-agent

# build/ tracks only the build script (build/keystore); its output is not tracked
build/install/
build/bin/
build/host
