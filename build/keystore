#!/usr/bin/env bash
# build/keystore — cross-compile the keystore CLI and keystore-agent and produce a
# self-contained install package, then optionally scp it to a host and run the
# installer over ssh. No service unit is installed: running the agent as a service is
# an operator decision (see examples/agent-service).
#
#   build/keystore [--cli] [user@host]     linux/amd64 install package (optionally deployed)
#   build/keystore --release               release archives for every supported platform
#
# With no host the package is built under build/install/ but not transmitted.
# With a host (positional, or the build/host file) the package + installer are
# scp'd over and the installer is run via ssh.
#
# Builds are reproducible: -trimpath, CGO_ENABLED=0, the toolchain pinned in go.mod,
# -buildvcs=true, and a version stamped from git. That holds for a clean checkout only:
# a dirty tree (tracked changes or untracked files, which Go also counts) is stamped
# -dirty, and --release refuses it. Every package carries THIRD-PARTY-NOTICES and an
# SPDX SBOM.

set -eu

MODE=package
case "${1:-}" in
    --cli) shift ;;
    --release) MODE=release; shift ;;
esac

NAME=keystore
BIN=/usr/local/bin
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
export GOWORK=off CGO_ENABLED=0

# every binary under cmd/ that has sources yet
BINARIES=
for b in keystore keystore-agent; do
    if ls "cmd/$b"/*.go >/dev/null 2>&1; then BINARIES="$BINARIES $b"; fi
done
BINARIES=${BINARIES# }

HISTORY=$NAME.version
INSTALLER=$NAME.sh
PACKAGE=$NAME.tgz

HOST=${1:-}
if [ -z "$HOST" ] && [ -e build/host ]; then
    HOST=$(cat build/host)
fi

# Go bakes vcs.modified=true into the binary for any uncommitted change, so the version
# must say so too (git describe --dirty ignores untracked files; porcelain does not).
DIRTY=
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then DIRTY=-dirty; fi
if [ "$MODE" = release ] && [ -n "$DIRTY" ]; then
    echo "build/keystore: refusing --release from a dirty tree (commit or clean it first):" >&2
    git status --porcelain >&2
    exit 1
fi

BUILD=$ROOT/build
INSTALL=$BUILD/install
rm -rf "$INSTALL"
mkdir -p "$INSTALL"

VERSION=$(git describe --tags 2>/dev/null || echo dev)$DIRTY
REVISION=$(git rev-parse --short=12 HEAD 2>/dev/null || echo none)
LDFLAGS="-s -w -X main.version=$VERSION -X main.build=$REVISION"
GOFLAGS_BUILD="-trimpath -buildvcs=true"

# sbom FILE BINARY: SPDX 2.3 tag-value SBOM from the module data embedded in BINARY.
sbom() {
    local out=$1 bin=$2
    {
        echo "SPDXVersion: SPDX-2.3"
        echo "DataLicense: CC0-1.0"
        echo "SPDXID: SPDXRef-DOCUMENT"
        echo "DocumentName: $NAME-$VERSION"
        echo "DocumentNamespace: https://github.com/netstar-labs/keystore/spdx/$VERSION-$REVISION"
        echo "Creator: Tool: build/keystore"
        echo "Created: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo
        echo "PackageName: github.com/netstar-labs/keystore"
        echo "SPDXID: SPDXRef-keystore"
        echo "PackageVersion: $VERSION"
        echo "PackageDownloadLocation: https://github.com/netstar-labs/keystore"
        echo "FilesAnalyzed: false"
        echo "PackageLicenseConcluded: NOASSERTION"
        echo "PackageLicenseDeclared: NOASSERTION"
        echo "PackageCopyrightText: NOASSERTION"
        echo "ExternalRef: PACKAGE-MANAGER purl pkg:golang/github.com/netstar-labs/keystore@$VERSION"
        echo "Relationship: SPDXRef-DOCUMENT DESCRIBES SPDXRef-keystore"
        go version -m "$bin" | awk '
            NR == 1 { goversion = $2 }
            $1 == "dep" {
                n++
                printf "\nPackageName: %s\nSPDXID: SPDXRef-dep-%d\nPackageVersion: %s\n", $2, n, $3
                printf "PackageDownloadLocation: https://%s\nFilesAnalyzed: false\n", $2
                printf "PackageLicenseConcluded: BSD-3-Clause\nPackageLicenseDeclared: BSD-3-Clause\nPackageCopyrightText: Copyright 2009 The Go Authors\n"
                printf "PackageComment: <text>go.sum %s</text>\n", $4
                printf "ExternalRef: PACKAGE-MANAGER purl pkg:golang/%s@%s\n", $2, $3
                printf "Relationship: SPDXRef-keystore DEPENDS_ON SPDXRef-dep-%d\n", n
            }
            END {
                printf "\nPackageName: go (standard library)\nSPDXID: SPDXRef-go-stdlib\nPackageVersion: %s\n", goversion
                printf "PackageDownloadLocation: https://go.dev/dl/\nFilesAnalyzed: false\n"
                printf "PackageLicenseConcluded: BSD-3-Clause\nPackageLicenseDeclared: BSD-3-Clause\nPackageCopyrightText: Copyright 2009 The Go Authors\n"
                printf "Relationship: SPDXRef-keystore DEPENDS_ON SPDXRef-go-stdlib\n"
            }'
    } > "$out"
}

if [ "$MODE" = release ]; then
    OUT=$INSTALL/release
    mkdir -p "$OUT"
    echo "VERSION  $VERSION $REVISION (release)"
    for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do
        os=${target%/*} arch=${target#*/}
        dir=$OUT/$NAME-$VERSION-$os-$arch
        mkdir -p "$dir"
        for b in $BINARIES; do
            echo "BUILD    $b -> $target"
            GOOS=$os GOARCH=$arch go build $GOFLAGS_BUILD -ldflags "$LDFLAGS" -o "$dir/$b" "./cmd/$b"
        done
        cp README.md SECURITY.md THIRD-PARTY-NOTICES "$dir/"
        [ -e LICENSE ] && cp LICENSE "$dir/"
        sbom "$dir/$NAME.spdx" "$dir/keystore"
        tar -czf "$OUT/$NAME-$VERSION-$os-$arch.tgz" -C "$OUT" "$NAME-$VERSION-$os-$arch"
        rm -rf "$dir"
    done
    (cd "$OUT" && if command -v sha256sum >/dev/null; then sha256sum ./*.tgz; else shasum -a 256 ./*.tgz; fi | sed 's| \./| |' > SHA256SUMS)
    echo "RELEASE  $OUT"
    cat "$OUT/SHA256SUMS"
    echo "         build: GOWORK=off CGO_ENABLED=0 go build $GOFLAGS_BUILD -ldflags \"$LDFLAGS\" ./cmd/..."
    echo "bye"
    exit 0
fi

echo "VERSION  $VERSION $REVISION"
date -u +%Y.%m.%d.%H.%M | tr '\n' ' ' >> "$INSTALL/$HISTORY"
echo "$VERSION $REVISION $BINARIES" >> "$INSTALL/$HISTORY"
for b in $BINARIES; do
    echo "BUILD    $b (./cmd/$b) -> linux/amd64"
    GOOS=linux GOARCH=amd64 go build $GOFLAGS_BUILD -ldflags "$LDFLAGS" -o "$INSTALL/$b" "./cmd/$b"
done
cp THIRD-PARTY-NOTICES "$INSTALL/"
sbom "$INSTALL/$NAME.spdx" "$INSTALL/keystore"

echo "BUILD    $INSTALLER"
{
cat << EOF_HEAD
#!/bin/sh
# generated by build/keystore — installs the keystore CLI and agent
set -eu
INSTALL=install
PACKAGE=$PACKAGE
HISTORY=$HISTORY
BINARIES="$BINARIES"
BIN=$BIN
EOF_HEAD
cat << 'EOF_BODY'

[ "$(id -u)" = 0 ] || { echo "installer: run as root (sudo ./keystore.sh)"; exit 1; }
rm -rf "$INSTALL"
tar -xzf "$PACKAGE"
mkdir -p "$BIN/version"
mv "$INSTALL/$HISTORY" "$BIN/version/"
for b in $BINARIES; do
    cp "$INSTALL/$b" "$BIN/"
    chmod 0755 "$BIN/$b"
    echo "install: $b -> $BIN/$b"
done
mkdir -p /usr/local/share/doc/keystore
cp "$INSTALL/THIRD-PARTY-NOTICES" "$INSTALL/keystore.spdx" /usr/local/share/doc/keystore/
echo "install: notices + SBOM -> /usr/local/share/doc/keystore/"
rm -rf "$INSTALL" "$PACKAGE" keystore.sh
echo "install: complete"
EOF_BODY
} > "$INSTALL/$INSTALLER"
chmod a+x "$INSTALL/$INSTALLER"

echo "BUILD    $PACKAGE"
tar -czf "$BUILD/$PACKAGE" -C "$BUILD" install
mv "$BUILD/$PACKAGE" "$INSTALL/$PACKAGE"

if [ -n "$HOST" ]; then
    echo "TRANSMIT $PACKAGE + $INSTALLER -> $HOST"
    scp "$INSTALL/$PACKAGE" "$INSTALL/$INSTALLER" "$HOST:"
    echo "RUN      $HOST: sudo ./$INSTALLER"
    ssh "$HOST" "sudo ./$INSTALLER"
    rm -rf "$INSTALL"
else
    echo "PACKAGE  $INSTALL/$PACKAGE"
    echo "         (no host — scp this package + $INSTALLER to a server and run sudo ./$INSTALLER)"
fi
echo "bye"
