# systemd user unit for keystore-agent. Install (not done by any script here):
#   cp keystore-agent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now keystore-agent
# Clients then use: keystore sign -agent "$XDG_RUNTIME_DIR/keystore/agent.sock" ...
[Unit]
Description=keystore signing agent (key held in memory only)
# A start that keeps failing (wrong passphrase, missing ring) must not loop forever: give up
# after 5 tries in a minute; the reason is in `journalctl --user -u keystore-agent`.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# %h = home, %t = $XDG_RUNTIME_DIR. RuntimeDirectory creates %t/keystore mode 0700.
ExecStart=/usr/local/bin/keystore-agent -keystore %h/.config/keystore/prod.ks -id prod-2026 -sock %t/keystore/agent.sock -passfile %h/.config/keystore/pass -ttl 0 -idle 0
RuntimeDirectory=keystore
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5
# No core dumps: a dump would contain the unlocked key.
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
