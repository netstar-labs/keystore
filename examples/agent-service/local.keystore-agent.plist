<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent for keystore-agent. launchd does not expand ~ or variables:
  replace /Users/YOU before installing (not done by any script here):
    mkdir -m 700 -p /Users/YOU/.config/keystore/run
    cp local.keystore-agent.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.keystore-agent.plist
  Clients then use: keystore sign -agent /Users/YOU/.config/keystore/run/agent.sock ...
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.keystore-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/keystore-agent</string>
        <string>-keystore</string><string>/Users/YOU/.config/keystore/prod.ks</string>
        <string>-id</string><string>prod-2026</string>
        <string>-sock</string><string>/Users/YOU/.config/keystore/run/agent.sock</string>
        <string>-passfile</string><string>/Users/YOU/.config/keystore/pass</string>
        <string>-ttl</string><string>0</string>
        <string>-idle</string><string>0</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on crash, not after a clean exit (e.g. SIGTERM). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- A start that keeps failing (wrong passphrase, missing ring) is relaunched without
         limit; at least wait 60 s between tries. The reason is in the log file below. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <!-- No core dumps: a dump would contain the unlocked key. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/keystore-agent.log</string>
</dict>
</plist>
